+
+# Native NVFP4 W4A4 draft experiment. Target and cache are unchanged.
+_native_original_mode = draft_quant_mode
+_native_original_quantize = quantize_rows
+_native_original_gemv = gemv_q8
+
+def draft_quant_mode():
+    if os.environ.get("INKLING2_DRAFT_QUANT", "").lower() == "nvfp4-native":
+        return "nvfp4-native"
+    return _native_original_mode()
+
+@torch.no_grad()
+def quantize_rows(weight, mode, out=None, chunk=8192):
+    if mode != "nvfp4-native":
+        return _native_original_quantize(weight, mode, out, chunk)
+    from flashinfer import nvfp4_quantize, SfLayout
+    if weight.shape[1] % 64 or weight.shape[0] % 64:
+        raise ValueError(f"native NVFP4 shape unsupported: {tuple(weight.shape)}")
+    global_scale = (2688.0 / weight.float().abs().amax().clamp_min(1e-12)).reshape(1)
+    packed, blocks = nvfp4_quantize(weight.contiguous(), global_scale, sfLayout=SfLayout.layout_128x4, do_shuffle=False)
+    if out is None:
+        return packed, (blocks, global_scale)
+    out[0].copy_(packed)
+    out[1][0].copy_(blocks)
+    out[1][1].copy_(global_scale)
+    return out
+
+def gemv_q8(x, q, scale, bias=None, out_dtype=None):
+    if not isinstance(scale, tuple):
+        return _native_original_gemv(x, q, scale, bias, out_dtype)
+    from flashinfer import nvfp4_quantize, SfLayout
+    from flashinfer.gemm import mm_fp4
+    blocks, weight_global = scale
+    leading = x.shape[:-1]
+    x2 = x.reshape(-1, x.shape[-1]).contiguous()
+    activation_global = (2688.0 / x2.float().abs().amax().clamp_min(1e-12)).reshape(1)
+    packed_x, scale_x = nvfp4_quantize(x2, activation_global, sfLayout=SfLayout.layout_128x4, do_shuffle=False)
+    answer = mm_fp4(packed_x, q.T, scale_x, blocks.T,
+                    1.0 / (activation_global * weight_global), out_dtype or x.dtype,
+                    backend="cute-dsl")
+    if bias is not None:
+        answer = answer + bias
+    return answer.view(*leading, q.shape[0])
